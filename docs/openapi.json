          }
        ],
        "parameters": [
          {
            "name": "agencyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agency shifts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["agencyId", "shifts"],
                  "properties": {
                    "agencyId": {
                      "type": "string"
                    },
                    "shifts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Shift"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
