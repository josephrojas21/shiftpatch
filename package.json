{
  "name": "shiftpatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --import tsx scripts/run-e2e.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:contract": "node --import tsx scripts/run-e2e.ts e2e/api-contract.spec.ts",
    "api:docs": "node --import tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.0.0",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "posthog-js": "^1.280.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  },
  "type": "module"
}
